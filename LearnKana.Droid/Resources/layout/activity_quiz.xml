<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    
    <LearnKana.Droid.MVVM.Views.Toolbars.ActivityToolbarView
        android:id="@+id/activity_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/margin_small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LearnKana.Droid.MVVM.Views.Widgets.ProgressView
            android:id="@+id/progress_view"
            android:layout_margin="@dimen/margin_small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LearnKana.Droid.MVVM.Views.Widgets.TimerProgressBar
            android:id="@+id/timer_progress_bar"
            style="@style/CircularProgressBarStyle"
            android:layout_margin="@dimen/margin_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <com.google.android.material.divider.MaterialDivider
            android:layout_margin="@dimen/margin_small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@id/fragment_container_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

</LinearLayout>